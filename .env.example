PORT=3000
STUDIO_ADMIN_TOKEN=replace-with-yet-another-long-random-secret
STUDIO_ADMIN_RATE_LIMIT_PER_MINUTE=60
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=whatsapp_bot
WWEBJS_CLIENT_ID=bot
WA_AUTH_ENCRYPTION_KEY=replace-with-a-stable-random-secret-at-least-32-characters
WA_COMMAND_CLAIM_TTL_MS=604800000
WA_COMMAND_MAX_AGE_MS=86400000
